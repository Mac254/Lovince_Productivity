{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "types": [
            "node",
            "vite/client",
            "unplugin-icons/types/vue"
        ],
        "paths": {
            "@/*": [
                "./apps/web/src/*"
            ]
        }
    },
    "include": [
        "apps/web/src/**/*.test.ts",
        "apps/web/src/auto-imports.d.ts",
        "apps/web/src/components.d.ts",
        "packages/*/src/**/*.test.ts"
    ]
}
