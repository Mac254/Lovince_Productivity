{
    "name": "focus",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "dev": "concurrently -k -n api,web,logs,schedule,queue -c magenta,yellow,cyan,green,blue \"pnpm dev:api\" \"pnpm dev:web\" \"pnpm logs\" \"pnpm schedule\" \"pnpm queue\"",
        "dev:web": "pnpm --filter @focus/web dev",
        "dev:api": "cd apps/api && php artisan focus:doctor && php artisan serve",
        "build": "pnpm --filter @focus/web build",
        "typecheck": "pnpm --filter @focus/web typecheck && vue-tsc -p tsconfig.vitest.json --noEmit && tsc -p tsconfig.node.json --noEmit",
        "test": "vitest run",
        "test:api": "cd apps/api && php artisan test",
        "lint": "eslint .",
        "format": "prettier --write \"apps/web/src/**/*.{ts,vue}\" \"packages/*/src/**/*.{ts,vue}\" \"packages/*/scripts/**/*.ts\"",
        "test:watch": "vitest",
        "tokens": "pnpm --filter @focus/tokens build",
        "types": "cd apps/api && php artisan focus:types",
        "doctor": "cd apps/api && php artisan focus:doctor",
        "logs": "cd apps/api && php artisan pail --timeout=0",
        "schedule": "cd apps/api && php artisan schedule:work",
        "queue": "cd apps/api && php artisan queue:listen --tries=3",
        "app:install": "scripts/local-app.sh install",
        "app:update": "scripts/local-app.sh update",
        "app:status": "scripts/local-app.sh status",
        "app:logs": "scripts/local-app.sh logs",
        "app:open": "scripts/local-app.sh open",
        "app:uninstall": "scripts/local-app.sh uninstall",
        "app:autostart": "scripts/local-app.sh autostart"
    },
    "devDependencies": {
        "@iconify-json/solar": "^1.2.13",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.6",
        "eslint": "^10.13.0",
        "eslint-plugin-vue": "^10.12.0",
        "jsdom": "^30.1.3",
        "pinia": "^4.1.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "unplugin-icons": "^24.0.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0",
        "vue-tsc": "^3.3.13"
    },
    "engines": {
        "node": ">=26.12.0",
        "pnpm": ">=12.15.0"
    }
}
