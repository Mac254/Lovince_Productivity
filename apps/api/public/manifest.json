{
    "name": "Focus",
    "short_name": "Focus",
    "description": "Your private dashboard for tasks, goals, blockers, journal and daily reports.",
    "id": "/",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone"],
    "background_color": "#eef0ec",
    "theme_color": "#000000",
    "categories": ["productivity"],
    "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        { "name": "Today", "url": "/today", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
        { "name": "Focus timer", "url": "/focus?mode=timer", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
        { "name": "Journal", "url": "/journal", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
    ]
}
