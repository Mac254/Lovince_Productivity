{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "api",
            "runtimeExecutable": "php",
            "runtimeArgs": [
                "apps/api/artisan",
                "serve",
                "--port=8000"
            ],
            "port": 8000
        },
        {
            "name": "web",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "--filter",
                "@focus/web",
                "dev"
            ],
            "port": 5173
        }
    ]
}
